# Autonomous AI SecOps Log Analyzer
# Environment variables - copy to .env and fill in values

# LLM Provider Configuration (all optional - app works offline)
# Supported: openai, anthropic, google, local, offline
LLM_PROVIDER=offline

# Cloud LLM API Keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Local LLM endpoint (optional)
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama2

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./secops_analyzer.db
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100
MAX_TOOL_CALLS_PER_INVESTIGATION=20
INVESTIGATION_TIMEOUT_SECONDS=120

# Security
SECRET_KEY=change-this-in-production
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8000

# Data Retention
MAX_ANALYSIS_AGE_DAYS=90
MAX_STORED_ANALYSES=100
